{
  "name": "@onlo-ai/react-native",
  "version": "0.3.2",
  "license": "SEE LICENSE IN LICENSE",
  "description": "React Native bridge for the native Onlo mobile SDKs.",
  "homepage": "https://github.com/onlo-ai/onlo-mobile-sdks/tree/main/packages/react-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onlo-ai/onlo-mobile-sdks.git",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/onlo-ai/onlo-mobile-sdks/issues"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "customer-support",
    "messenger",
    "onlo"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/src",
    "OnloReactNative.podspec",
    "ios/Sources",
    "react-native.config.js",
    "src"
  ],
  "codegenConfig": {
    "name": "OnloSDKSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "ai.onlo.reactnative"
    }
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.79"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc src/index.ts src/NativeOnloSDK.ts src/react-native-codegen-shim.d.ts --target ES2022 --module commonjs --moduleResolution node --skipLibCheck --outDir /private/tmp/onlo-rn-facade-test && ONLO_FACADE_PATH=/private/tmp/onlo-rn-facade-test/index.js node --test test/*.test.mjs"
  }
}

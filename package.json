{
  "name": "onlo-mobile-sdks",
  "version": "0.1.0",
  "private": true,
  "description": "Onlo native mobile SDK workspace and protocol conformance contracts.",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/protocol"
  ],
  "scripts": {
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "test:conformance": "node --test conformance/test/manifest.test.mjs",
    "test:hygiene": "node --test scripts/check-hygiene.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:protocol-fixtures": "node --test packages/protocol/test/fixtures.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  }
}
